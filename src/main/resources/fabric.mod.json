{
    "schemaVersion": 1,
    "id": "recipeimageextractor",
    "version": "${version}",
    "name": "Recipe Image Extractor",
    "description": "Export Recipes as PNG images",
    "authors": [
        {
            "name": "Duisterethomas",
            "homepage": "https://duisterethomas.nl/"
        },
        "Brenton \"B-Train\" Fletcher"
    ],
    "contact": {
		"homepage": "https://modrinth.com/project/recipeimageextractor",
		"issues": "https://github.com/duisterethomas/mc-recipe-image-extractor/issues",
		"sources": "https://github.com/duisterethomas/mc-recipe-image-extractor"
    },
    "license": "MIT",
    "icon": "assets/recipeimageextractor/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "adapter": "kotlin",
                "value": "nl.duisterethomas.recipeimageextractor.RecipeImageExtractor"
            }
        ]
    },
    "accessWidener": "recipeimageextractor.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.0",
        "minecraft": ">=1.21 <=1.21.1",
        "java": ">=21",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    }
}